[
  {
    "name": "UU看书",
    "group": "网络小说",
    "kind": "text",
    "format": "html",
    "url": "https://www.uukan.org/",
    "search": "/search/{key}.html",
    "discover": "/",
    "sample": "三体",
    "originNote": "源仓库书源 8081",
    "rules": {
      "list": ".bookbox",
      "title": ".bookname a@text",
      "author": ".author@text",
      "book": ".bookname a@href",
      "description": ".update@text",
      "discoverList": "#fengtui .item",
      "discoverTitle": "dt a[href^='/book/']@text",
      "discoverAuthor": "dt a[href^='/search/']@text",
      "discoverBook": "dt a[href^='/book/']@href",
      "discoverDescription": "dd@text",
      "toc": "#allchapter dd:not([data-num]) a[href^='/chapter/']@href",
      "chapters": "#allchapter a[href]",
      "chapterTitle": "@text",
      "chapterUrl": "@href",
      "nextToc": "#linkNext@href",
      "content": "#content@text",
      "nextContent": "@next"
    }
  },
  {
    "name": "速读谷",
    "group": "网络小说",
    "kind": "text",
    "format": "html",
    "url": "https://www.suduguu.com/",
    "search": "/i/sor.aspx?key={key}",
    "discover": "/",
    "sample": "三体",
    "originNote": "源仓库书源合集 1320",
    "rules": {
      "list": ".item",
      "title": ".itemtxt h3 a, .itemtxt h1 a@text",
      "author": ".itemtxt p a@text",
      "book": ".itemtxt h3 a, .itemtxt h1 a@href",
      "description": ".des bb@text",
      "chapters": "#list li a",
      "chapterTitle": "@text",
      "chapterUrl": "@href",
      "content": ".con@text",
      "nextContent": "@next"
    }
  },
